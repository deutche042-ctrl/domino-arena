# Domino Arena — GitHub + Cloudflare deployment settings.
# Copy this file to .env and fill the values. .env is gitignored.
# These keys are for deployment tooling only; the Node server reads its
# runtime settings (PORT, TURN_*, etc.) from the hosting environment.

# ── GitHub ──────────────────────────────────────────────────────────
# Optional personal access token for scripted pushes/API calls.
# Classic PAT scopes: repo (and workflow if you push workflow files).
# Fine-grained PAT: Contents Read/Write + Workflows Read/Write.
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=domino-arena
GITHUB_BRANCH=master

# ── Cloudflare Workers ──────────────────────────────────────────────
# Create at: Cloudflare dashboard → My Profile → API Tokens.
# Permissions: Account → Workers Scripts:Edit, Account Settings:Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Reference values: match worker/wrangler.toml + your workers.dev subdomain.
CLOUDFLARE_WORKER_NAME=domino-arena
CLOUDFLARE_WORKERS_SUBDOMAIN=
# Deployed Worker URL, used by the remote e2e check.
DOMINO_URL=
